<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AspireVersion>13.0.0</AspireVersion>
    <OpenTelemetryVersion>1.12.0</OpenTelemetryVersion>
  </PropertyGroup>
  <ItemGroup>        
    <PackageVersion Include="MediatR" Version="[12.5.0]" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.MongoDB" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.MongoDB.Driver" Version="13.6.4" />
    <PackageVersion Include="Aspire.Npgsql" Version="13.6.4" />
    <!-- ServiceDefaults (OpenTelemetry) -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>
</Project>